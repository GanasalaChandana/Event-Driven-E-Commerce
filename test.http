# Works with the VS Code "REST Client" extension.
# Fill in the variables below locally — never commit real passwords or tokens.
@baseUrl = https://event-driven-e-commerce.onrender.com
@adminEmail = admin@shopflow.com
@adminPassword = REPLACE_ME
@userEmail = user@example.com
@userPassword = REPLACE_ME

### Login as Admin
# @name adminLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

@adminToken = {{adminLogin.response.body.token}}

###  ─────────────────────────────────────────────
###  PRODUCTS (Admin only)
###  ─────────────────────────────────────────────

### Create Product
POST {{baseUrl}}/api/v1/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Wireless Headphones",
  "description": "High quality noise-cancelling headphones",
  "price": 99.99,
  "sku": "WH-001",
  "categoryId": null
}

### List Products
GET {{baseUrl}}/api/v1/products

### Search Products by name
GET {{baseUrl}}/api/v1/products?q=headphones

### Filter Products by category
GET {{baseUrl}}/api/v1/products?categoryId=9129a5e4-99be-4720-b886-4bb0f01813cc

###  ─────────────────────────────────────────────
###  INVENTORY (Admin only)
###  ─────────────────────────────────────────────

### Add Inventory
POST {{baseUrl}}/api/v1/inventory
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "productId": "ee04ec8d-a1a3-4941-9f78-6dd19dfdc381",
  "productName": "Wireless Headphones",
  "quantityToAdd": 100
}

### Check Stock
GET {{baseUrl}}/api/v1/inventory/ee04ec8d-a1a3-4941-9f78-6dd19dfdc381

### Adjust Stock (set absolute quantity — Admin only)
PUT {{baseUrl}}/api/v1/inventory/ee04ec8d-a1a3-4941-9f78-6dd19dfdc381
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "quantity": 200
}

###  ─────────────────────────────────────────────
###  CATEGORIES (Admin create / Public list)
###  ─────────────────────────────────────────────

### List all categories
GET {{baseUrl}}/api/v1/categories

### Create a category (Admin only)
POST {{baseUrl}}/api/v1/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Electronics",
  "description": "Electronic devices and accessories"
}

###  ─────────────────────────────────────────────
###  USER ACCOUNT — Register + Login as a test user
###  ─────────────────────────────────────────────

### Step 1: Register a test user (run once only)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### Step 2: Login as the test user — the token is captured into @userToken below
# @name userLogin
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

@userToken = {{userLogin.response.body.token}}

###  ─────────────────────────────────────────────
###  USER PROFILE
###  ─────────────────────────────────────────────

### Get my profile (as test user)
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{userToken}}

### Get my profile (as Admin)
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{adminToken}}

### Get any user by ID (Admin only — paste the test user's id from login response)
GET {{baseUrl}}/api/v1/users/eb4d83de-9ab7-4d79-a432-75a7d7a14bb8
Authorization: Bearer {{adminToken}}

###  ─────────────────────────────────────────────
###  ORDERS — Place as test user (triggers email)
###  ─────────────────────────────────────────────

### Step 3: Place Order — confirmation email sent to {{userEmail}}
POST {{baseUrl}}/api/v1/orders
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "items": [
    {
      "productId": "ee04ec8d-a1a3-4941-9f78-6dd19dfdc381",
      "quantity": 1
    }
  ]
}

### Cancel Order (PENDING only — paste order ID from Place Order response)
POST {{baseUrl}}/api/v1/orders/d8fb8434-26d4-4a6f-bd22-edb93afeec40/cancel
Authorization: Bearer {{userToken}}

### Get My Orders (as test user)
GET {{baseUrl}}/api/v1/orders
Authorization: Bearer {{userToken}}

### Get Order by ID (as test user)
GET {{baseUrl}}/api/v1/orders/PASTE_ORDER_ID_HERE
Authorization: Bearer {{userToken}}

###  ─────────────────────────────────────────────
###  ADMIN — All Orders (new endpoints)
###  ─────────────────────────────────────────────

### Get ALL orders from all users (paginated)
GET {{baseUrl}}/api/v1/admin/orders
Authorization: Bearer {{adminToken}}

### Get all CONFIRMED orders
GET {{baseUrl}}/api/v1/admin/orders?status=CONFIRMED
Authorization: Bearer {{adminToken}}

### Get all PENDING orders
GET {{baseUrl}}/api/v1/admin/orders?status=PENDING
Authorization: Bearer {{adminToken}}

### Get all CANCELLED orders
GET {{baseUrl}}/api/v1/admin/orders?status=CANCELLED
Authorization: Bearer {{adminToken}}

### Get any order by ID (admin can see any user's order)
GET {{baseUrl}}/api/v1/admin/orders/PASTE_ORDER_ID_HERE
Authorization: Bearer {{adminToken}}

### Update order status (admin — paste order ID, set status to CONFIRMED or CANCELLED)
PATCH {{baseUrl}}/api/v1/admin/orders/297b5618-62b5-40a1-affc-bbad51575aff/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "status": "CANCELLED"
}

###  ─────────────────────────────────────────────
###  ADMIN — Users
###  ─────────────────────────────────────────────

### Get ALL users (paginated)
GET {{baseUrl}}/api/v1/admin/users
Authorization: Bearer {{adminToken}}

### Get user by ID (admin)
GET {{baseUrl}}/api/v1/admin/users/eb4d83de-9ab7-4d79-a432-75a7d7a14bb8
Authorization: Bearer {{adminToken}}

###  ─────────────────────────────────────────────
###  ADMIN — Own Orders
###  ─────────────────────────────────────────────

### Get Admin's own orders
GET {{baseUrl}}/api/v1/orders
Authorization: Bearer {{adminToken}}


### Assign category to Wireless Headphones
PUT {{baseUrl}}/api/v1/products/ee04ec8d-a1a3-4941-9f78-6dd19dfdc381
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Wireless Headphones",
  "description": "High quality noise-cancelling headphones",
  "price": 99.99,
  "sku": "WH-001",
  "categoryId": "9129a5e4-99be-4720-b886-4bb0f01813cc"
}

### Get Wireless Headphones by ID
GET {{baseUrl}}/api/v1/products/ee04ec8d-a1a3-4941-9f78-6dd19dfdc381